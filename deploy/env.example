# Template for /etc/hdb/env on the production host (root:root, mode 600).
# Copy to /etc/hdb/env and fill in real values -- never commit the real
# file (see .gitignore and the "Policy" note in CLAUDE.md's PostgreSQL
# section). Loaded by systemd (EnvironmentFile=/etc/hdb/env in
# deploy/systemd/hdb-gunicorn.service) and, for manual smoke-checks,
# by `sudo bash -c 'set -a; source /etc/hdb/env; set +a; ...'`.

# --- Database (see settings.py's DJANGO_DB_TYPE gotcha in CLAUDE.md) ---
DJANGO_DB_TYPE=postgres
DJANGO_DB_NAME=CHANGE_ME
DJANGO_DB_USER=CHANGE_ME
DJANGO_DB_PASSWORD=CHANGE_ME
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# --- Hardening (see CLAUDE.md's "Production settings" note,
#     2026-09-28) -- all three fail *closed* if left unset, unlike
#     DJANGO_DB_TYPE above, so an incomplete env file breaks loudly
#     (DEBUG off, only localhost allowed) rather than reopening
#     debug pages. ---
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=epic-hwdb.sdcc.bnl.gov,epic-hwdb01.sdcc.bnl.gov,127.0.0.1
# Generate with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME
